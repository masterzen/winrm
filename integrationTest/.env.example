# Copy to .env.integration (gitignored), fill in real values, then:
#   set -a; source integrationTest/.env.integration; set +a
#   go test ./integrationTest/... -v

# Scenarios: NoEncryption, NTLM, NTLMSealed, CredSSP — same account, same host.
export WINRM_IT_HOST=
export WINRM_IT_USER=
export WINRM_IT_PASSWORD=
# export WINRM_IT_PORT=5985
# export WINRM_IT_HTTPS=1
# export WINRM_IT_INSECURE=0

# Scenarios: Kerberos, KerberosEncrypted — a domain-joined host.
export WINRM_IT_KERBEROS_HOST=
export WINRM_IT_KERBEROS_REALM=
export WINRM_IT_KERBEROS_USER=
export WINRM_IT_KERBEROS_PASSWORD=
# export WINRM_IT_KERBEROS_CCACHE=      # alternative to _PASSWORD
export WINRM_IT_KERBEROS_CONFIG=        # path to krb5.conf
